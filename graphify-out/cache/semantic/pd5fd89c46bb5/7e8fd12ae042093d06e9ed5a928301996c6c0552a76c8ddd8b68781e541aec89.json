{"nodes": [{"id": "docs_ac_layout_mapping_design_specification", "label": "AC Layout & Mapping Design Specification", "file_type": "document", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ac_layout_mapping_design_specification_daikin_2pk_split_wall", "label": "Daikin 2 PK Split Wall Reference Unit (18,000 BTU/h, 1050mm)", "file_type": "concept", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ac_layout_mapping_design_specification_wall_space_constraints", "label": "Wall Space Constraints (>=1.05m absolute, >=1.55m recommended)", "file_type": "rationale", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indoor body is 1.05m; 0.25m side clearance each side gives 1.55m recommended length."}, {"id": "docs_ac_layout_mapping_design_specification_throw_distance_zones", "label": "Throw Distance Zones (0-2.5 / 2.5-5.5 / 5.5-7.5 m)", "file_type": "concept", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L46", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ac_layout_mapping_design_specification_thermal_gradient_superposition", "label": "Thermal Potential Gradient with Additive Superposition", "file_type": "rationale", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wide-mouth directional plume (70 deg) from full louver width; overlapping AC intensities sum and clamp at 1.0 to reflect additive cooling."}, {"id": "docs_ac_layout_mapping_design_specification_dead_zone_detection", "label": "Dead Zone Detection (<20% intensity)", "file_type": "concept", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ac_layout_mapping_design_specification_restricted_zones", "label": "AC Restricted Zones (Glass/Door, Open Chiller, Cashier)", "file_type": "rationale", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No bracket structure and high heat radiation at glass; above chillers blocks service access, risks condensate drips and disrupts air curtain; cashier wall cluttered by backwall/menu boards and staff draft discomfort."}, {"id": "docs_ac_layout_mapping_design_specification_ac_clearance_rules", "label": "AC Clearance Rules (2.5-3.0m between units, corner clearance)", "file_type": "rationale", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents short-cycling where a neighbor unit sucks in cold air; corner gap keeps side circulation free."}, {"id": "docs_ac_layout_mapping_design_specification_ac_layout_tool", "label": "AC Layout Tool (/ac-layout)", "file_type": "concept", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built as a standalone tool with two-way access: redirect from /ac-estimation with params, and a direct card in CalculatorGrid so auditors can draw without weather/GPS form."}, {"id": "docs_ac_layout_mapping_design_specification_thermal_vs_layout_reconciliation", "label": "Thermal Load vs Physical Layout Unit Reconciliation", "file_type": "rationale", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load may say 5 but layout needs 4 (area cut by chiller, compact room >=90% coverage) or vice versa (L-shaped rooms, corridors beyond 7.5m throw). Dual evaluation panel shows BTU target vs coverage % with smart insights to justify CAPEX/OPEX."}, {"id": "docs_ac_layout_mapping_design_specification_ashrae_references", "label": "ASHRAE Handbook / Standard 55 / Standard 72", "file_type": "paper", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L206", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ac_layout_mapping_design_specification_foster_display_cabinets", "label": "Foster et al. - Effect of ambient air movement on refrigerated display cabinets", "file_type": "paper", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L212", "source_url": "https://doi.org/10.1016/j.ijrefrig.2004.11.006", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ac_layout_mapping_design_specification_daikin_installation_manual", "label": "Daikin Installation Manual / Engineering Data Book (FTKC/FTV)", "file_type": "paper", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L201", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ac_layout_mapping_design_specification_calculatorgrid", "label": "CalculatorGrid", "file_type": "code", "source_file": "docs/ac_layout_mapping_design_specification.md", "source_location": "L144", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_ac_layout_mapping_design_specification", "target": "docs_ac_layout_mapping_design_specification_daikin_2pk_split_wall", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ac