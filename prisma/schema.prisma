generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(USER)
  fullName      String?   @map("full_name")
  branch        String?
  emailVerified Boolean?  @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  audits          Audit[]   @relation("AuditAuditor")
  validatedAudits Audit[]   @relation("AuditValidator")
  auditCorrections AuditCorrection[]
  deviceAccess     UserDeviceAccess[] @relation("DeviceAccessUser")
  grantedDeviceAccess UserDeviceAccess[] @relation("DeviceAccessCreator")
  sessions      Session[]
  accounts      Account[]
  acCalculatorLogs    AcCalculatorLog[]
  lightCalculatorLogs LightCalculatorLog[]
  mepSimulationLogs   MepSimulationLog[]
  energyAudits        EnergyAudit[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Store {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  name            String
  branch          String?
  plnCustomerId   String?   @map("pln_customer_id")
  type            String
  is24Hours       Boolean   @default(false) @map("is_24_hours")
  openTime        String?   @map("open_time")
  closeTime       String?   @map("close_time")
  plnPowerVa      Int       @map("pln_power_va")
  parkingAreaM2   Decimal   @map("parking_area_m2")
  terraceAreaM2   Decimal   @map("terrace_area_m2")
  salesAreaM2     Decimal   @map("sales_area_m2")
  warehouseAreaM2 Decimal   @map("warehouse_area_m2")
  toiletAreaM2    Decimal   @default(0) @map("toilet_area_m2")
  corridorAreaM2  Decimal   @default(0) @map("corridor_area_m2")
  latitude        Float?    @map("latitude")
  longitude       Float?    @map("longitude")
  address         String?   @map("address")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  audits          Audit[]
  energyAudits    EnergyAudit[]

  @@map("stores")
}

model EquipmentType {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  category       String
  deviceCategory String           @default("Lainnya") @map("device_category")
  defaultKw      Decimal          @map("default_kw")
  storeType      String?          @map("store_type")
  calcMethod     String           @default("STANDARD") @map("calc_method")
  calcDuration   Int?             @map("calc_duration")
  createdAt      DateTime         @default(now()) @map("created_at")
  
  brands      EquipmentBrand[]
  auditItems  AuditItem[]

  @@map("equipment_types")
}

model EquipmentBrand {
  id              String        @id @default(uuid()) @db.Uuid
  equipmentTypeId String        @map("equipment_type_id") @db.Uuid
  name            String
  baseKw          Decimal       @map("base_kw") // Diisi dengan defaultKw dari EquipmentType saat dibuat
  standbyKw       Decimal       @default(0) @map("standby_kw")
  runningKw       Decimal       @default(0) @map("running_kw")
  areaTarget      AreaTarget    @default(SALES) @map("area_target")
  productPhotoUrl   String?       @map("product_photo_url")
  nameplatePhotoUrl String?       @map("nameplate_photo_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  
  type            EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Cascade)
  auditItems      AuditItem[]

  @@map("equipment_brands")
}

model Audit {
  id                        String                @id @default(uuid()) @db.Uuid
  storeId                   String                @map("store_id") @db.Uuid
  auditorId                 String                @map("auditor_id") @db.Uuid
  status                    AuditStatus           @default(DRAFT)
  auditDate                 DateTime              @default(now()) @map("audit_date")
  isBoros                   Boolean?              @map("is_boros")
  totalEstimatedKwhPerMonth Decimal?              @map("total_estimated_kwh_per_month")
  avgActualPlnKwhPerMonth   Decimal?              @map("avg_actual_pln_kwh_per_month")
  // (aktual - estimasi) / estimasi * 100, dipakai untuk mengurutkan toko paling boros
  gapPercent                Decimal?              @map("gap_percent")
  validationStatus          AuditValidationStatus @default(PENDING) @map("validation_status")
  validatedAt               DateTime?             @map("validated_at")
  validatedById             String?               @map("validated_by_id") @db.Uuid
  // Store technical data as entered for this audit, so history keeps its own values
  storeType                 String?               @map("store_type")
  plnPowerVa                Int?                  @map("pln_power_va")
  parkingAreaM2             Decimal?              @map("parking_area_m2")
  terraceAreaM2             Decimal?              @map("terrace_area_m2")
  salesAreaM2               Decimal?              @map("sales_area_m2")
  warehouseAreaM2           Decimal?              @map("warehouse_area_m2")
  toiletAreaM2              Decimal?              @map("toilet_area_m2")
  corridorAreaM2            Decimal?              @map("corridor_area_m2")
  is24Hours                 Boolean?              @map("is_24_hours")
  openTime                  String?               @map("open_time")
  closeTime                 String?               @map("close_time")
  // Results as submitted by the store, copied before the first correction during validation
  originalIsBoros                   Boolean? @map("original_is_boros")
  originalTotalEstimatedKwhPerMonth Decimal? @map("original_total_estimated_kwh_per_month")
  originalAvgActualPlnKwhPerMonth   Decimal? @map("original_avg_actual_pln_kwh_per_month")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")
  items                     AuditItem[]
  corrections               AuditCorrection[]
  plnHistory                AuditPlnStdHistory[]
  recommendations           AuditRecommendation[]
  energyAudits              EnergyAudit[]
  auditor                   User                  @relation("AuditAuditor", fields: [auditorId], references: [id])
  validatedBy               User?                 @relation("AuditValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  store                     Store                 @relation(fields: [storeId], references: [id])

  @@index([validationStatus, gapPercent])
  @@map("audits")
}

model AuditItem {
  id                String          @id @default(uuid()) @db.Uuid
  auditId           String          @map("audit_id") @db.Uuid
  equipmentTypeId   String?         @map("equipment_type_id") @db.Uuid
  equipmentBrandId  String?         @map("equipment_brand_id") @db.Uuid
  areaTarget        AreaTarget      @map("area_target")
  customName        String?         @map("custom_name")
  brandName         String          @default("") @map("brand_name")
  qty               Int
  operationalHours  Decimal         @map("operational_hours")
  baseKw            Decimal         @map("base_kw")
  estimatedDailyKwh Decimal         @map("estimated_daily_kwh")
  usageCount        Int?            @map("usage_count")
  notes             String?         @map("notes")
  
  audit             Audit           @relation(fields: [auditId], references: [id])
  equipmentType     EquipmentType?  @relation(fields: [equipmentTypeId], references: [id])
  equipmentBrand    EquipmentBrand? @relation(fields: [equipmentBrandId], references: [id])

  @@map("audit_items")
}

model AuditPlnStdHistory {
  id                     String  @id @default(uuid()) @db.Uuid
  auditId                String  @map("audit_id") @db.Uuid
  monthIdx               Int     @map("month_idx")
  billingMonth           String  @map("billing_month")
  plnUsageKwh            Decimal @map("pln_usage_kwh")
  salesTransactionPerDay Decimal @map("sales_transaction_per_day")
  audit                  Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("audit_pln_std_history")
}

model AuditRecommendation {
  id          String             @id @default(uuid()) @db.Uuid
  auditId     String             @map("audit_id") @db.Uuid
  type        RecommendationType
  title       String
  description String
  audit       Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("audit_recommendations")
}

enum Role {
  USER
  ADMIN
  AUDITOR
  GS
  AREA
}

// Devices (devices.id in DB 2) a GS user may see in smart-energy-monitoring.
model UserDeviceAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  deviceId  String   @map("device_id")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User  @relation("DeviceAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  creator User? @relation("DeviceAccessCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([userId, deviceId])
  @@map("user_device_access")
}

enum AuditStatus {
  DRAFT
  COMPLETED
}

enum AuditValidationStatus {
  PENDING
  VALIDATED
}

enum AuditCorrectionType {
  ITEM_ADDED
  ITEM_UPDATED
  ITEM_DELETED
  PLN_UPDATED
  TECHNICAL_UPDATED
  ADDRESS_UPDATED
  RECOMMENDATION_UPDATED
}

// One row per change a validator makes to a kalkulasi before validating it.
model AuditCorrection {
  id          String              @id @default(uuid()) @db.Uuid
  auditId     String              @map("audit_id") @db.Uuid
  validatorId String?             @map("validator_id") @db.Uuid
  type        AuditCorrectionType
  summary     String
  before      Json?
  after       Json?
  createdAt   DateTime            @default(now()) @map("created_at")

  audit     Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  validator User? @relation(fields: [validatorId], references: [id], onDelete: SetNull)

  @@index([auditId, createdAt])
  @@map("audit_corrections")
}

enum EnergyAuditCategory {
  TATA_CAHAYA
  TATA_UDARA_VENTILASI
  REFRIGERASI
  SELUBUNG_BANGUNAN
  KELISTRIKAN
  BEBAN_PASIF_STOPKONTAK
  BEANSPOT
}

enum EnergyAuditStatus {
  DRAFT
  COMPLETED
}

// Field audit per category. `data` holds the category-specific form, so new
// categories need no new table; summary columns stay queryable for reports.
model EnergyAudit {
  id            String              @id @default(uuid()) @db.Uuid
  storeId       String              @map("store_id") @db.Uuid
  sourceAuditId String?             @map("source_audit_id") @db.Uuid
  category      EnergyAuditCategory
  status        EnergyAuditStatus   @default(DRAFT)
  auditorId     String              @map("auditor_id") @db.Uuid
  auditDate     DateTime            @default(now()) @map("audit_date")
  summaryStatus String?             @map("summary_status")
  data          Json
  completedAt   DateTime?           @map("completed_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  store       Store  @relation(fields: [storeId], references: [id])
  sourceAudit Audit? @relation(fields: [sourceAuditId], references: [id], onDelete: SetNull)
  auditor     User   @relation(fields: [auditorId], references: [id])

  @@unique([sourceAuditId, category])
  @@index([category, status])
  @@map("energy_audits")
}

enum AreaTarget {
  PARKING
  TERRACE
  SALES
  WAREHOUSE
}

enum RecommendationType {
  TRAINING
  REPAIR
  MAINTENANCE
}

enum StoreMode {
  EXISTING
  NEW
}

model AcCalculatorLog {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  userEmail        String?   @map("user_email")
  storeMode        StoreMode @default(EXISTING) @map("store_mode")
  storeCode        String?   @map("store_code")
  storeName        String?   @map("store_name")
  branch           String?
  salesArea        Decimal   @map("sales_area")
  maxTemp          Decimal   @map("max_temp")
  clusterBtu       Int       @map("cluster_btu")
  totalBtu         Int       @map("total_btu")
  recommendedUnits Int       @map("recommended_units")
  latitude         Float?
  longitude        Float?
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("ac_calculator_logs")
}

model LightCalculatorLog {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  userEmail        String?   @map("user_email")
  storeMode        StoreMode @default(EXISTING) @map("store_mode")
  storeCode        String?   @map("store_code")
  storeName        String?   @map("store_name")
  branch           String?
  salesArea        Decimal   @map("sales_area")
  shapeType        String?   @map("shape_type")
  dimensions       String?
  lampWatt         Decimal   @map("lamp_watt")
  minUnits         Int       @map("min_units")
  maxUnits         Int       @map("max_units")
  installedUnits   Int       @map("installed_units")
  targetLux        Int?      @map("target_lux")
  powerRatio       Decimal?  @map("power_ratio")
  standardStatus   String?   @map("standard_status")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("light_calculator_logs")
}

model MepSimulationLog {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  userEmail        String?   @map("user_email")
  storeMode        StoreMode @default(EXISTING) @map("store_mode")
  storeCode        String?   @map("store_code")
  storeName        String?   @map("store_name")
  branch           String?
  salesArea        Decimal   @map("sales_area")
  
  maxTemp          Decimal   @map("max_temp")
  clusterBtu       Int       @map("cluster_btu")
  totalBtu         Int       @map("total_btu")
  recommendedUnits Int       @map("recommended_units")
  installedUnits   Int       @map("installed_units")
  outdoorNotes     String?   @map("outdoor_notes")
  
  lampWatt         Decimal   @map("lamp_watt")
  targetLux        Int       @map("target_lux")
  lampCount        Int       @map("lamp_count")
  estimatedLux     Int?      @map("estimated_lux")
  
  layoutData       Json      @map("layout_data")
  notes            String?
  isDraft          Boolean   @default(false) @map("is_draft")
  
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeCode])
  @@index([branch])
  @@index([createdAt])
  @@map("mep_simulation_logs")
}
